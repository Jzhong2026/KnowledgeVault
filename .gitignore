## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/

# Centralized log directory (backend runtime + dev/scratch logs).
# The directory structure is preserved in source via .keep placeholders.
# All *.log, *.jsonl, *.txt (and *.tmp / *.scratch) inside any logs/ folder
# are ignored — do not commit log contents. .keep and README.md inside any
# logs/ tree are whitelisted so the layout survives in source.
#
# We intentionally do NOT add a directory-level rule like "logs/" here:
# gitignore cannot re-include a file when its parent directory is excluded,
# which would silently drop the .keep placeholders.
**/logs/**/*.log
**/logs/**/*.jsonl
**/logs/**/*.txt
**/logs/**/*.tmp
**/logs/**/*.scratch
!**/logs/**/*.keep
!**/logs/**/README.md
!**/logs/**/readme.md

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Local deployment output
/src/KnowledgeVault/publish/
/.tmp/

# Local SQLite databases
*.db
*.db-shm
*.db-wal

# The checked-in server database is part of the IIS publish payload. Its WAL
# sidecars remain local runtime files and must never be committed.
!db/
!db/knowledge-vault.db

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Local development secrets (never commit)
src/KnowledgeVault/KnowledgeVault/appsettings.Development.json

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/
.vs/
categories_debug.png

# MSBuild Binary and Structured Log
*.binlog

# Node (stray root install, e.g. npm run at repo root)
/node_modules/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Disposable local test databases, E2E output, screenshots, and debug captures.
# Test source projects remain under src/ and are tracked normally.
/test/

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
/src/KnowledgeVault/.vs/KnowledgeVault.slnx/v18
/src/KnowledgeVault/.vs/KnowledgeVault.slnx
*.user
/src/KnowledgeVault/.vs/ProjectEvaluation/knowledgevault.metadata.v10.bin
/src/KnowledgeVault/.vs/ProjectEvaluation/knowledgevault.projects.v10.bin
/src/KnowledgeVault/.vs/ProjectEvaluation/knowledgevault.strings.v10.bin

# Stray dev/tooling artifacts (never commit)
$null
npm_err.txt
ef_install.txt
ef_version.txt
tmp_mighist/
playwright-report/
verify_result.txt
e2e_out.txt
frontend_build.txt
src/knowledge-vault-web/test-results/

# Transient test/debug output captured via Tee-Object. These are scratch
# files generated while iterating locally and are safe to delete at any
# time — they have no relationship to the committed source.
backend_stdout.log
e2e_crumb.txt
e2e_crumb2.txt
e2e_crumb3.txt
e2e_exit.txt
e2e_full.txt
e2e_full2.txt
e2e_full3.txt
e2e_parent.txt
e2e_test2.txt
e2e_test3.txt
e2e_usability.txt
frontend_test.txt
proxy_check.txt
proxy_check2.txt
register_admin_result.txt
backend_debug.bat
frontend_debug.bat
launch_kv.bat

# Catch-all for any future stray debug/scratch logs and one-off outputs.
# Anything ending in .log or that looks like a transient text dump is local-only.
*.log
*.tmp
*.scratch
