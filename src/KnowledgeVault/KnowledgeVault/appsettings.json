{
  "ConnectionStrings": {
    "KnowledgeVaultDb": "Data Source=knowledge-vault.db"
  },
  "Jwt": {
    "Issuer": "KnowledgeVault",
    "Audience": "KnowledgeVault",
    "SigningKey": "${KV_JWT_SIGNING_KEY}",
    "ExpirationMinutes": 20160
  },
  "Swagger": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Logs": {
    "Directory": "logs/backend/runtime"
  },
  "Llm": {
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "${KV_LLM_API_KEY}",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "ChatTimeoutSeconds": 60,
    "EmbeddingTimeoutSeconds": 30,
    "IntentClassificationModel": "gpt-4o-mini"
  },
  "VectorStore": {
    "Provider": "Chroma",
    "Endpoint": "http://localhost:8000",
    "Collection": "knowledge_vault_chunks",
    "Distance": "cosine",
    "ApiKey": ""
  },
  "AllowedHosts": "*"
}
